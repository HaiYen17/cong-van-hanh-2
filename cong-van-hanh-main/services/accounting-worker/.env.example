# PostgreSQL/Cloud SQL. Production nên inject bằng Secret Manager.
ACCOUNTING_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Tối thiểu 32 ký tự ở production. Không dùng giá trị ví dụ này ngoài local.
ACCOUNTING_WORKER_SECRET=replace-with-a-long-random-secret

# Khóa Fernet độc lập để mã hóa Bearer/cookie MISA.
# Tạo bằng: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ACCOUNTING_CREDENTIAL_KEY=replace-with-a-fernet-key

ACCOUNTING_ENVIRONMENT=development
ACCOUNTING_SCHEMA=accounting_runtime
ACCOUNTING_CONFIG_SCHEMA=accounting_portal
ACCOUNTING_PAGE_BATCH=30
ACCOUNTING_SLICE_SECONDS=40
ACCOUNTING_REQUEST_TIMEOUT=60
ACCOUNTING_MAX_PAGE_SIZE=1000
ACCOUNTING_MAX_REPORT_ROWS=100000
ACCOUNTING_MAX_EXPORT_BYTES=25000000
ACCOUNTING_DB_POOL_MAX=6

# Cloud Run mặc định nên để false và gọi /jobs/continue bằng Cloud Tasks/Cloud Scheduler.
# Chỉ bật true khi service được cấp CPU luôn hoạt động.
ACCOUNTING_AUTORUN=false

# Cấu hình nền để kế toán tạo khối MISA đầu tiên chỉ bằng Bearer.
# DatabaseId/BranchId là một khối neo đang hoạt động, chỉ dùng để MISA trả danh sách.
ACCOUNTING_MISA_BOOTSTRAP_COMPANY_KEY=
ACCOUNTING_MISA_BOOTSTRAP_TENANT_ID=
ACCOUNTING_MISA_BOOTSTRAP_TENANT_CODE=
ACCOUNTING_MISA_BOOTSTRAP_DATABASE_ID=
ACCOUNTING_MISA_BOOTSTRAP_BRANCH_ID=

# Khi có nhiều công ty, dùng JSON theo companyKey thay cho nhóm biến đơn ở trên.
# ACCOUNTING_MISA_BOOTSTRAP_CONTEXTS={"TVG":{"TenantId":"...","TenantCode":"...","DatabaseId":"...","BranchId":"..."}}
ACCOUNTING_MISA_BOOTSTRAP_CONTEXTS=
