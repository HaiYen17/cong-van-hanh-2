# Copy this file to .env for local development.
# Do not commit real secrets, passwords, or production connection strings.

# Local development connects through Cloud SQL Auth Proxy.
# Start proxy first:
# C:\tools\cloud-sql-proxy\cloud-sql-proxy.x86.exe --address 127.0.0.1 --port 5433 tvg-ops-dev:asia-southeast1:tvg-postgres-dev
DATABASE_URL="postgresql://cvh_migration_user:PASSWORD@127.0.0.1:5433/cong_van_hanh_dev?schema=public"
AUTH_SESSION_SECRET="replace-with-at-least-32-random-characters"
APP_URL="http://localhost:3000"

# Điều khiển máy lạnh. Chỉ bật live sau khi đã có chấp thuận tích hợp doanh nghiệp
# bằng văn bản; URL/secret luôn nằm ở server, không gửi xuống trình duyệt.
AIR_CONTROL_LIVE_AUTHORIZED="false"
# AIR_CONTROL_BRIDGE_URL="https://air-control-bridge.example.internal"
# AIR_CONTROL_BRIDGE_SECRET=""
# Các biến AIR_CONTROL_* chỉ là fallback. Admin cấu hình chính tại Cấu hình → Hunonic.
# AIR_CONTROL_HUNONIC_USERNAME=""
# AIR_CONTROL_HUNONIC_PASSWORD=""
# AIR_CONTROL_HUNONIC_TOKEN=""

# Mã hóa password/token/API key của Cấu hình Tổng trước khi lưu PostgreSQL.
# Dùng chuỗi ngẫu nhiên tối thiểu 32 ký tự; production lấy từ Secret Manager.
CONFIG_SECRET_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"

# Worker Kế toán. `start-dev.ps1` có thể tự đọc secret dev từ Google Cloud
# nếu máy đã đăng nhập gcloud; không chép secret thật vào file này.
ACCOUNTING_WORKER_URL="https://thuanviet-accounting-worker-fe6q7l75dq-as.a.run.app"
# ACCOUNTING_WORKER_SECRET=""
# Cloud Run production phải dùng "true"; local worker dùng "false".
ACCOUNTING_WORKER_USE_ID_TOKEN="true"
ACCOUNTING_WORKER_TIMEOUT_MS="120000"
ACCOUNTING_EXPORT_BUCKET="tvg-ops-dev-cong-van-hanh-files"

# Đồng bộ bài test ứng viên từ Google Form/Google Sheet vào PostgreSQL.
# Các ID dưới đây có mặc định production hiện tại; chỉ khai báo khi đổi nguồn.
# RECRUITMENT_RESULTS_SPREADSHEET_ID=""
# RECRUITMENT_TRACKING_SPREADSHEET_ID=""
# RECRUITMENT_SCORING_SPREADSHEET_ID=""
# RECRUITMENT_FORM_SYNC_SCHEDULER_SERVICE_ACCOUNT=""
# CRON_SECRET=""

# Optional for `npm run db:seed`.
# If SEED_SUPER_ADMIN_PASSWORD is empty, the seed script generates a temporary password.
SEED_SUPER_ADMIN_USERNAME="superadmin"
SEED_SUPER_ADMIN_EMAIL="superadmin@cong-van-hanh.local"
SEED_SUPER_ADMIN_NAME="Super Admin"
# SEED_SUPER_ADMIN_PASSWORD=""
# SEED_SUPER_ADMIN_RESET_PASSWORD="false"
