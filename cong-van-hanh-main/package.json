    "db:import-recruitment-scoring": "node prisma/import-recruitment-scoring.mjs",
    "db:import-warehouse": "node --conditions=react-server --import tsx scripts/import-warehouse-legacy.ts",
    "db:studio": "prisma studio",
    "test:accounting": "tsx --test src/lib/accounting/*.test.ts",
    "test:air-control": "node --conditions=react-server --import tsx --test src/lib/air-control/*.test.ts",
    "test:motivation": "node --import tsx --test src/lib/motivation-policy.test.ts",
    "test:permissions": "node --conditions=react-server --import tsx --test src/lib/auth/*.test.ts",
    "qa:permissions": "node --env-file=.env --conditions=react-server --import tsx scripts/qa-permission-integrity.ts",
    "qa:permissions:production": "node --env-file=.env --conditions=react-server --import tsx scripts/qa-permission-production.ts",
