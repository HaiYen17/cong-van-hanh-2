    "qa:evaluation-jd-backfill": "node --env-file=.env --conditions=react-server --import tsx scripts/backfill-evaluation-jd-scores.ts",
    "db:backfill-evaluation-jd": "node --env-file=.env --conditions=react-server --import tsx scripts/backfill-evaluation-jd-scores.ts --apply",
    "db:seed-evaluation-work-groups": "node --env-file=.env --conditions=react-server --import tsx scripts/seed-evaluation-work-groups.ts --apply",
    "db:repair-evaluation-integrity": "node --env-file=.env --conditions=react-server --import tsx scripts/repair-evaluation-integrity.ts --apply",
    "qa:evaluation-integrity": "node --env-file=.env --conditions=react-server --import tsx scripts/qa-evaluation-integrity.ts",
    "qa:evaluation-write-contract": "node --env-file=.env --conditions=react-server --import tsx scripts/qa-evaluation-write-contract.ts",
    "qa:document-numbering": "node --env-file=.env --conditions=react-server --import tsx scripts/qa-document-numbering.ts",
    "snapshot:document-numbering": "node --env-file=.env --conditions=react-server --import tsx scripts/snapshot-document-numbering.ts",
    "qa:evaluation-repair-plan": "node --env-file=.env --conditions=react-server --import tsx scripts/repair-evaluation-integrity.ts",
    "test:warehouse": "node --conditions=react-server --import tsx --test src/lib/warehouse/*.test.ts",
    "test:workshop": "node --conditions=react-server --import tsx --test src/lib/workshop/*.test.ts",
    "qa:warehouse": "node --conditions=react-server --import tsx scripts/qa-warehouse.ts",
    "qa:warehouse-info": "node --conditions=react-server --import tsx scripts/qa-warehouse-info.ts",
    "db:ensure-warehouse-key": "node --conditions=react-server --import tsx scripts/ensure-warehouse-api-key.ts",
    "qa:warehouse-api": "node --conditions=react-server --import tsx scripts/qa-warehouse-api.ts",
    "qa:warehouse-mobile-api": "node --conditions=react-server --import tsx scripts/qa-warehouse-mobile-api.ts",
    "qa:workshop": "node --env-file=.env --conditions=react-server --import tsx scripts/qa-workshop.ts",
    "qa:workshop-write": "node --env-file=.env --conditions=react-server --import tsx scripts/qa-workshop-write.ts",
    "audit:warehouse-api-key": "node --conditions=react-server --import tsx scripts/audit-warehouse-api-key.ts",
    "export:warehouse-api": "node --import tsx scripts/export-warehouse-api-contract.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "google-auth-library": "9.15.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "mqtt": "^5.15.2",
    "next": "16.2.11",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "pdfmake": "^0.3.11",
    "pg": "^8.21.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfmake": "^0.3.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.16"
    },
    "minimatch@5.1.9": {
      "brace-expansion": "2.1.2"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.8"
    },
    "fast-uri": "^3.1.4",
    "js-yaml": "^4.3.0",
    "hono": "^4.12.27",
    "@hono/node-server": "^2.0.5",
    "sharp": "^0.35.3",
    "postcss": "^8.5.22",
    "find-my-way": "^9.7.0"
  }
