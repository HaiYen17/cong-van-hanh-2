    "qa:recruitment-panel-access": "node --env-file=.env --conditions=react-server --import tsx scripts/backfill-recruitment-panel-access.ts",
    "qa:recruitment-context-runtime": "node --env-file=.env --conditions=react-server --import tsx scripts/qa-recruitment-context-runtime.ts",
    "qa:recruitment-context-production": "node --env-file=.env --conditions=react-server --import tsx scripts/qa-recruitment-context-production.ts",
    "db:backfill-recruitment-panel-access": "node --env-file=.env --conditions=react-server --import tsx scripts/backfill-recruitment-panel-access.ts --apply",
    "db:repair-permissions": "node --env-file=.env --conditions=react-server --import tsx scripts/repair-permission-default-groups.ts --apply",
    "test:meetings": "node --conditions=react-server --import tsx --test src/lib/meetings/*.test.ts",
    "test:inbox": "node --conditions=react-server --import tsx scripts/qa-inbox-runtime.ts",
    "test:document-numbering": "node --import tsx --test src/lib/document-registry.test.ts",
    "test:jd-policy": "tsx --test src/lib/evaluation/jd-policy.test.ts",
    "test:recruitment": "node --conditions=react-server --import tsx --test src/lib/recruitment/*.test.ts",
    "test:evaluation": "node --env-file=.env --conditions=react-server --import tsx scripts/qa-evaluation.ts",
    "test:evaluation-mail": "node --conditions=react-server --import tsx --test src/lib/evaluation/mail-template.test.ts src/lib/evaluation/mail-delivery.test.ts",
    "qa:evaluation-mail-safety": "node --env-file=.env --conditions=react-server --import tsx scripts/qa-evaluation-mail-safety.ts",
    "qa:evaluation-mail-template-library": "node --env-file=.env --conditions=react-server --import tsx scripts/qa-evaluation-mail-template-library.ts",
    "test:evaluation-automation": "node --env-file=.env --conditions=react-server --import tsx scripts/qa-evaluation-automation.ts",
