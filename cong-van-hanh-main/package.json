{
  "name": "cong-van-hanh",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20.9.0 <23",
    "npm": ">=10.0.0 <11"
  },
  "scripts": {
    "setup:local": "node scripts/run-local-script.mjs setup",
    "setup:local:quick": "node scripts/run-local-script.mjs setup --skip-install",
    "dev:local": "node scripts/run-local-script.mjs dev",
    "dev": "next dev",
    "prebuild": "npm run check:encoding && npm run check:deploy-modules && npm run check:evaluation-v3-source && npm run check:recruitment-v3-source && npm run check:accounting-template-export && prisma generate",
    "build": "next build",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "check:deploy-modules": "node --conditions=react-server --import tsx scripts/check-deploy-module-inventory.ts",
    "build:legacy-parity": "node scripts/build-legacy-parity-pages.mjs",
    "check:legacy-scripts": "node scripts/check-legacy-scripts.mjs",
    "check:evaluation-v3-source": "node scripts/check-evaluation-v3-source.mjs",
    "check:recruitment-v3-source": "node scripts/check-recruitment-v3-source.mjs",
    "check:accounting-template-export": "node scripts/check-accounting-template-export.mjs",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.mjs",
    "db:import-global-config": "node prisma/import-global-config.mjs",
    "db:import-permissions": "node prisma/import-permissions.mjs",
    "db:import-document-types": "node prisma/import-document-types.mjs",
    "db:import-motivation": "node --env-file=.env --import tsx scripts/import-motivation-legacy.ts",
    "db:import-seal-partners": "tsx scripts/import-seal-partners.ts",
    "db:ensure-authorization-types": "tsx scripts/ensure-authorization-letter-types.ts",
